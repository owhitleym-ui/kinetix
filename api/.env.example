# Copy to .env and fill in. Never commit .env or the wallet folder.

PORT=3001

# Autonomous DB (use ADMIN for hackathon, or app_user later)
DB_USER=ADMIN
DB_PASSWORD=your_atp_admin_password
# TNS alias from wallet tnsnames.ora
DB_CONNECT_STRING=uvkz5dgrw1jk04o0_high
# Absolute or relative path to the unzipped wallet folder
WALLET_DIR=./Wallet_UVKZ5DGRW1JK04O0
# Password from the OCI "Download Wallet" dialog (not ADMIN password)
WALLET_PASSWORD=your_wallet_zip_password

# Default demo patient (must exist in PATIENTS, or API will upsert)
DEFAULT_PATIENT_ID=p1
DEFAULT_PATIENT_NAME=Demo Patient

# Object Storage (optional until you add an OCI API key)
OCI_REGION=us-chicago-1
OCI_NAMESPACE=
OCI_BUCKET=pt-app
OCI_COMPARTMENT_ID=
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
# Path to the .pem private key from "Add API Key" in OCI
OCI_PRIVATE_KEY_PATH=./oci_api_key.pem
# OCI_PRIVATE_KEY_PASSPHRASE=
