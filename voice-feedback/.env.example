# OpenAI — neural TTS (required for natural voice)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.92
# Style for natural conversational delivery (gpt-4o-mini-tts only)
OPENAI_TTS_INSTRUCTIONS=You are a warm female physical therapy coach. Speak at a natural conversational pace — clear, friendly, and human, with gentle pitch variation. Praise sincerely. Give form tips encouragingly, never flat, rushed, or robotic.

# Optional: also use OpenAI for cue wording (else keep backend :8000 / OCI GenAI)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# TTS proxy
TTS_PORT=3002
# Exact origins; *.vercel.app is also allowed in tts_server.js
CORS_ORIGINS=http://127.0.0.1:8801,http://localhost:8801,http://127.0.0.1:3002,null
