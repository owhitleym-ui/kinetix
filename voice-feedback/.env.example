CORS_ORIGINS=http://127.0.0.1:8801,http://localhost:8801,http://127.0.0.1:3002,null

# OpenAI — neural TTS (required for natural voice)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=1.35
# Style for energetic, human delivery (gpt-4o-mini-tts only)
OPENAI_TTS_INSTRUCTIONS=You are an upbeat female physical therapy coach. Sound warm, lively, and human with natural pitch variation and energy. Praise with genuine enthusiasm. Give form tips clearly and encouragingly, never flat or robotic.

# Optional: also use OpenAI for cue wording (else keep backend :8000 / OCI GenAI)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# TTS proxy
TTS_PORT=3002
# Exact origins; *.vercel.app is also allowed in tts_server.js
CORS_ORIGINS=http://127.0.0.1:8801,http://localhost:8801,http://127.0.0.1:3002,null
