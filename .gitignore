# Full skeleton data: download with scripts/get_data.sh (REHAB26-ViewAngles, CC BY-NC 4.0, ~690 MB).
# The compact derived dataset in dataset/ IS committed.
data/

# Generated by training/train_rehab26.py: held-out models + replay sequences for the tests (~150 MB)
tests/data/*
!tests/data/.gitkeep

# Local test videos: they can show people's faces, keep them out of the repo
web/testvideos/

# Screenshots from the browser tests
screenshots/

# Secrets and server logs (backend/.env holds OCI settings)
.env
.env.local
*.log
backend/data/
.vercel/

# Python
.venv/
__pycache__/
*.pyc

# OS / editors
.DS_Store
.vscode/
.idea/

# Node / Next build artifacts
node_modules/
.next/

# Local Next leftover (app source lives in web/)
frontend/

# Node ATP API secrets (never commit wallets / keys)
api/.env
api/Wallet_*/
api/**/Wallet_*/
api/*.pem
api/oci_api_key.pem
api/node_modules/
branch/api/.env
branch/api/Wallet_*/
branch/api/**/Wallet_*/
branch/api/*.pem
branch/api/oci_api_key.pem
branch/api/node_modules/


# Voice feedback TTS secrets
voice-feedback/.env
voice-feedback/out/
voice-feedback/server/node_modules/


.env.production
backend/.env.production

