# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# OCI Object Storage
OCI_NAMESPACE=your_namespace
OCI_BUCKET=pt-form-coach-sessions
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
# Set to 1 when running on OCI Compute with resource principal
# OCI_RESOURCE_PRINCIPAL=1

# OCI Model Deployment
OCI_MODEL_ENDPOINT=
OCI_MODEL_AUTH_TOKEN=

# OCI Generative AI
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
