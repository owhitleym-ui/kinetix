# OCI Generative AI (optional — local template fallbacks work without these)
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
# Optional dedicated endpoint; if empty, uses regional on-demand inference
OCI_GENAI_ENDPOINT=
OCI_REGION=us-chicago-1

# OCI config (~/.oci/config by default)
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# API
API_PORT=8000
CORS_ORIGINS=https://kinetix-six-drab.vercel.app,http://127.0.0.1:8801,http://localhost:8801

# OCI Object Storage for session logs (POST /sessions); without these, sessions go to backend/data/sessions/
OCI_NAMESPACE=
OCI_BUCKET=pt-form-coach-sessions
# Set to 1 when running on OCI Compute with resource principal
# OCI_RESOURCE_PRINCIPAL=1
