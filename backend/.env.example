# CORS — comma-separated frontend origins
# Same-origin nginx hosting needs little CORS; keep local + public host for debugging
CORS_ORIGINS=http://127.0.0.1:8801,http://localhost:8801,http://207-211-163-177.sslip.io,https://207-211-163-177.sslip.io

# --- OCI Generative AI (patient chat + detailed session summaries) ---
# 1) Create API key: Profile → API keys → Add API key → save ~/.oci/config + .pem
# 2) Compartment OCID: Identity → Compartments → copy OCID
# 3) Model id from Generative AI playground in us-chicago-1, e.g. meta.llama-3.3-70b-instruct
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
OCI_REGION=us-chicago-1
# Optional; default is https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# OCI_GENAI_ENDPOINT=
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# OCI Object Storage (session logs)
OCI_NAMESPACE=
OCI_BUCKET=pt-form-coach-sessions
# OCI_RESOURCE_PRINCIPAL=1

API_PORT=8000
